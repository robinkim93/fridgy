# apps/api 환경 변수 — Fly.io는 `fly secrets set KEY=...`로 등록 (레포에 커밋 금지)
SERVICE_NAME=fridgy-api
VERSION=0.0.0
CORS_ORIGINS=http://localhost:5173

# 레시피 공유 URL(F9): API 공개 URL(공유 링크·og:url·sitemap), 웹앱 URL(앱 열기 CTA), OG 이미지
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
OG_IMAGE_URL=http://localhost:5173/og-recipe.png

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# NVIDIA NIM (OpenAI 호환) — 모델 id는 무료 티어 가용 모델에 맞춰 조정
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_OCR_MODEL=qwen/qwen3.5-397b-a17b
NIM_LLM_MODEL=qwen/qwen3.5-397b-a17b

# OCR 엔진 우선순위: Google Vision → CLOVA → NIM(폴백)
# Google Cloud Vision (무료 티어 월 1,000건, 한국어). GCP Vision API 키.
GOOGLE_VISION_API_KEY=
# Naver CLOVA OCR (한국어 영수증 특화, 유료 건당). NCP Receipt 도메인.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# Supabase Storage 영수증 버킷 (비공개 버킷을 미리 생성)
RECEIPTS_BUCKET=receipts

# 내부 배치 엔드포인트 보호 토큰 (GitHub Actions cron이 사용)
INTERNAL_TOKEN=
