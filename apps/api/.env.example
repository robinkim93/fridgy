# apps/api 환경 변수 — Fly.io는 `fly secrets set KEY=...`로 등록 (레포에 커밋 금지)
SERVICE_NAME=fridgy-api
VERSION=0.0.0
CORS_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# NVIDIA NIM (OpenAI 호환) — 모델 id는 무료 티어 가용 모델에 맞춰 조정
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_OCR_MODEL=meta/llama-3.2-90b-vision-instruct
NIM_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Supabase Storage 영수증 버킷 (비공개 버킷을 미리 생성)
RECEIPTS_BUCKET=receipts

# 내부 배치 엔드포인트 보호 토큰 (GitHub Actions cron이 사용)
INTERNAL_TOKEN=
